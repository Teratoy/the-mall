   "id": "repeat-sleep_again-5",
   "moment": "sleep_again",
   "old": null,
   "conds": "settled often",
   "text": "THE FLOOR KNOWS MY SHAPE NOW.",
   "note": "comfort in routine"
  },
  {
   "id": "repeat-sleep_again-6",
   "moment": "sleep_again",
   "old": null,
   "conds": "dreamt again",
   "text": "WHY DO I ALWAYS WAKE AT THE GOOD PART?",
   "note": "dream cut short"
  },
  {
   "id": "repeat-sleep_again-7",
   "moment": "sleep_again",
   "old": null,
   "conds": "dreamt often",
   "text": "THE DREAMS ARE THE ONLY PLACE I LEAVE.",
   "note": "escape only in sleep"
  },
  {
   "id": "repeat-sleep_again-8",
   "moment": "sleep_again",
   "old": null,
   "conds": "timid",
   "text": "NOBODY CAME. GOOD. NOBODY CAME.",
   "note": "relief of surviving the night"
  },
  {
   "id": "repeat-sleep_again-9",
   "moment": "sleep_again",
   "old": null,
   "conds": "brave",
   "text": "UP. ANOTHER DAY OF WALLS.",
   "note": "grim resolve"
  },
  {
   "id": "repeat-sleep_again-10",
   "moment": "sleep_again",
   "old": null,
   "conds": "homebody",
   "text": "MY OWN BED. I CAN ALMOST FEEL IT.",
   "note": "missing a home it can't recall"
  },
  {
   "id": "repeat-sleep_again-11",
   "moment": "sleep_again",
   "old": null,
   "conds": "erratic",
   "text": "SOMEONE MOVED THINGS WHILE I SLEPT.",
   "note": "paranoia"
  },
  {
   "id": "repeat-sleep_again-12",
   "moment": "sleep_again",
   "old": null,
   "conds": "hungry",
   "text": "SLEEPING DOESN'T FILL ANYTHING.",
   "note": "woke hungry"
  },
  {
   "id": "repeat-sleep_again-13",
   "moment": "sleep_again",
   "old": null,
   "conds": "tired often",
   "text": "I SLEEP AND SLEEP. IT'S NEVER ENOUGH.",
   "note": "sleep that doesn't rest"
  },
  {
   "id": "repeat-sleep_again-14",
   "moment": "sleep_again",
   "old": null,
   "conds": "hopeless",
   "text": "SLEEP WAS BETTER.",
   "note": "prefers oblivion"
  },
  {
   "id": "repeat-sleep_again-15",
   "moment": "sleep_again",
   "old": null,
   "conds": "sure",
   "text": "TODAY. TODAY I FIND IT.",
   "note": "hope renewed each morning"
  },
  {
   "id": "repeat-sleep_again-16",
   "moment": "sleep_again",
   "old": null,
   "conds": "sociable",
   "text": "GOOD MORNING, NOBODY.",
   "note": "loneliness, dark humour"
  },
  {
   "id": "repeat-sleep_again-17",
   "moment": "sleep_again",
   "old": null,
   "conds": "curious",
   "text": "WHO KEEPS THE LIGHTS ON ALL NIGHT?",
   "note": "the lights never change"
  },
  {
   "id": "repeat-sleep_again-18",
   "moment": "sleep_again",
   "old": null,
   "conds": "scared",
   "text": "I DREAMT SOMEONE STOOD OVER ME.",
   "note": "fear of sleeping exposed"
