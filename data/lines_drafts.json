  {
   "id": "repeat-going_again-16",
   "moment": "going_again",
   "old": null,
   "conds": "generous",
   "text": "SORRY. TO WHOEVER WALKS HERE.",
   "note": "apology to strangers"
  },
  {
   "id": "repeat-going_again-17",
   "moment": "going_again",
   "old": null,
   "conds": "greedy",
   "text": "EVERYTHING I EAT ENDS UP ON THE FLOOR.",
   "note": "cakes for nothing"
