   "conds": "erratic again",
   "text": "IT LAUGHED. I HEARD IT LAUGH.",
   "note": "hearing the mall"
  },
  {
   "id": "repeat-traps_again-15",
   "moment": "traps_again",
   "old": null,
   "conds": "sociable",
   "text": "I HOPE NOBODY ELSE STEPS HERE.",
