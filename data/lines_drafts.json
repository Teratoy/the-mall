   "moment": "doors_again",
   "old": null,
   "conds": "settled",
   "text": "WHY AM I EVEN LOOKING?",
   "note": "habit outliving the hope"
  },
  {
   "id": "repeat-doors_again-17",
   "moment": "doors_again",
   "old": null,
   "conds": "generous",
   "text": "I'LL LEAVE IT OPEN FOR THE NEXT ONE.",
   "note": "small kindness"
  },
  {
   "id": "repeat-traps_again-1",
   "moment": "traps_again",
   "old": null,
   "conds": "",
   "text": "OF COURSE. OF COURSE IT WAS.",
   "note": "weary resignation"
  },
  {
   "id": "repeat-traps_again-2",
   "moment": "traps_again",
   "old": null,
   "conds": "",
   "text": "WHO SETS THESE? WHO RESETS THEM?",
   "note": "paranoia about a maker"
  },
  {
   "id": "repeat-traps_again-3",
   "moment": "traps_again",
   "old": null,
   "conds": "again",
   "text": "I LOOKED. I SWEAR I LOOKED.",
   "note": "self-doubt"
  },
  {
   "id": "repeat-traps_again-4",
   "moment": "traps_again",
   "old": null,
   "conds": "again",
   "text": "SAME PLACE IT HURT LAST TIME.",
   "note": "bodily memory"
  },
  {
   "id": "repeat-traps_again-5",
   "moment": "traps_again",
   "old": null,
   "conds": "often",
   "text": "MY BODY IS ALL OLD WOUNDS NOW.",
   "note": "worn down"
  },
