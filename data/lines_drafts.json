   "moment": "traps_again",
   "old": null,
   "conds": "often",
   "text": "AT LEAST IT STILL WANTS ME.",
   "note": "dark humour"
  },
  {
   "id": "repeat-traps_again-7",
   "moment": "traps_again",
   "old": null,
   "conds": "brave",
   "text": "IS THAT ALL YOU'VE GOT?",
   "note": "defiance at the building"
  },
  {
   "id": "repeat-traps_again-8",
   "moment": "traps_again",
   "old": null,
   "conds": "timid",
   "text": "I'LL NEVER TOUCH ANYTHING AGAIN.",
   "note": "shrinking, vow"
  },
  {
   "id": "repeat-traps_again-9",
   "moment": "traps_again",
   "old": null,
   "conds": "greedy",
   "text": "NOTHING HERE IS FREE. NOTHING.",
   "note": "lesson about taking"
  },
  {
   "id": "repeat-traps_again-10",
   "moment": "traps_again",
   "old": null,
   "conds": "curious",
   "text": "THERE MUST BE A PATTERN. THERE MUST.",
   "note": "trying to solve it"
  },
  {
   "id": "repeat-traps_again-11",
   "moment": "traps_again",
   "old": null,
   "conds": "curious often",
   "text": "I'VE LEARNT NOTHING. NOTHING AT ALL.",
   "note": "defeated inquiry"
  },
  {
   "id": "repeat-traps_again-12",
   "moment": "traps_again",
   "old": null,
   "conds": "bleeding",
   "text": "HOW MUCH MORE DO I HAVE IN ME?",
   "note": "fear of running out"
  },
  {
   "id": "repeat-traps_again-13",
   "moment": "traps_again",
   "old": null,
   "conds": "hurt often",
   "text": "I'M MORE SCAR THAN SKIN.",
   "note": "body as record"
  },
  {
   "id": "repeat-traps_again-14",
   "moment": "traps_again",
