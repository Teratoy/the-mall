   "moment": "traps_again",
   "old": null,
   "conds": "scared",
   "text": "EVERY STEP. I HAVE TO WATCH EVERY STEP.",
   "note": "hypervigilance"
  },
  {
   "id": "repeat-going_again-1",
   "moment": "going_again",
   "old": null,
   "conds": "",
   "text": "I USED TO HAVE A DOOR FOR THIS.",
   "note": "memory of before"
  },
