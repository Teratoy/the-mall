   "moment": "low_again",
   "old": null,
   "conds": "sociable",
   "text": "DON'T LET ANYONE SEE ME LIKE THIS.",
   "note": "sociable shame"
  },
  {
   "id": "repeat-low_again-11",
   "moment": "low_again",
   "old": null,
   "conds": "loner",
   "text": "NOBODY TO TELL ME NO.",
   "note": "loner, alone with it"
  },
  {
   "id": "repeat-low_again-12",
   "moment": "low_again",
   "old": null,
   "conds": "greedy",
   "text": "WASTE NOTHING. NOTHING.",
   "note": "greed turned grim"
  },
  {
   "id": "repeat-low_again-13",
   "moment": "low_again",
   "old": null,
   "conds": "homebody",
   "text": "MOTHER WOULD WEEP. IF I HAD ONE.",
   "note": "homebody, half-memory"
  },
  {
   "id": "repeat-low_again-14",
   "moment": "low_again",
   "old": null,
   "conds": "curious often",
   "text": "I WONDER WHAT IT'S DOING TO ME.",
   "note": "curious, detached"
  },
  {
   "id": "repeat-low_again-15",
   "moment": "low_again",
   "old": null,
   "conds": "parched",
   "text": "WATER IS WATER. IT'S WET. IT'S WATER.",
   "note": "parched rationalising"
  },
  {
   "id": "repeat-low_again-16",
   "moment": "low_again",
   "old": null,
   "conds": "starving",
   "text": "HUNGER WINS. HUNGER ALWAYS WINS.",
   "note": "starving resignation"
  },
  {
   "id": "repeat-low_again-17",
   "moment": "low_again",
   "old": null,
   "conds": "filthy often",
   "text": "I'M AS FOUL AS WHAT I EAT.",
   "note": "filthy, self-disgust"
  },
  {
   "id": "repeat-low_again-18",
   "moment": "low_again",
   "old": null,
   "conds": "settled",
   "text": "YOU GET USED TO IT. YOU DO.",
   "note": "settled, wry numb"
  },
  {
   "id": "repeat-doors_again-1",
   "moment": "doors_again",
   "old": null,
   "conds": "",
   "text": "EVERY KEY FITS. NONE OF THEM MATTER.",
   "note": "the cruelty of success"
  },
  {
   "id": "repeat-doors_again-2",
   "moment": "doors_again",
   "old": null,
   "conds": "",
   "text": "SOMEONE MADE ALL THESE LOCKS. WHY?",
   "note": "quiet paranoia"
  },
  {
   "id": "repeat-doors_again-3",
   "moment": "doors_again",
   "old": null,
   "conds": "again",
   "text": "MAYBE THE NEXT ONE. MAYBE.",
   "note": "hope, still holding"
  },
  {
   "id": "repeat-doors_again-4",
   "moment": "doors_again",
   "old": null,
   "conds": "again",
   "text": "I'M GETTING GOOD AT THIS. GOOD FOR WHAT?",
   "note": "skill without purpose"
  },
  {
   "id": "repeat-doors_again-5",
   "moment": "doors_again",
   "old": null,
   "conds": "often",
   "text": "I COULD DO THIS IN MY SLEEP. MAYBE I AM.",
   "note": "numb, dreamlike"
  },
  {
   "id": "repeat-doors_again-6",
   "moment": "doors_again",
   "old": null,
   "conds": "often",
   "text": "CLICK. AND NOTHING. CLICK. AND NOTHING.",
   "note": "rhythm of futility"
  },
  {
   "id": "repeat-doors_again-7",
   "moment": "doors_again",
   "old": null,
   "conds": "brave",
   "text": "FINE. NEXT.",
   "note": "stubborn, clipped"
  },
  {
   "id": "repeat-doors_again-8",
   "moment": "doors_again",
   "old": null,
   "conds": "timid",
   "text": "PLEASE BE EMPTY. PLEASE.",
   "note": "fear of what's behind"
  },
  {
   "id": "repeat-doors_again-9",
   "moment": "doors_again",
   "old": null,
   "conds": "greedy keys",
   "text": "MORE KEYS THAN WAYS OUT.",
   "note": "hoarding feels hollow"
  },
  {
   "id": "repeat-doors_again-10",
   "moment": "doors_again",
   "old": null,
   "conds": "curious again",
   "text": "THE LOCKS ARE ALL THE SAME. ALL OF THEM.",
