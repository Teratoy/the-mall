   "conds": "filthy",
   "text": "I'M PART OF THE MESS NOW.",
   "note": "self-disgust"
  },
  {
   "id": "repeat-going_again-14",
   "moment": "going_again",
   "old": null,
   "conds": "filthy often",
   "text": "I CAN'T SMELL MYSELF ANY MORE.",
   "note": "lost to it"
  },
  {
