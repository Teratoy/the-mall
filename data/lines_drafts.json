  {
   "id": "repeat-sleep_again-1",
   "moment": "sleep_again",
   "old": null,
   "conds": "",
   "text": "THE CEILING HASN'T MOVED.",
   "note": "same view, wry"
  },
  {
   "id": "repeat-sleep_again-2",
   "moment": "sleep_again",
   "old": null,
   "conds": "again",
   "text": "FOR ONE SECOND I DIDN'T KNOW. THEN I DID.",
   "note": "the moment memory returns"
  },
  {
   "id": "repeat-sleep_again-3",
   "moment": "sleep_again",
   "old": null,
   "conds": "often",
   "text": "THE WORST PART IS IT FEELS NORMAL.",
   "note": "routine as dread"
  },
  {
   "id": "repeat-sleep_again-4",
   "moment": "sleep_again",
   "old": null,
   "conds": "often",
   "text": "SLEEP, WAKE, WALK. SLEEP, WAKE.",
   "note": "losing track of time"
  },
