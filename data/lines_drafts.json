  {
   "id": "repeat-quiet_again-1",
   "moment": "quiet_again",
   "old": null,
   "conds": "",
   "text": "I'VE STARTED HUMMING. TO HAVE SOMETHING.",
   "note": "filling the silence"
  },
  {
   "id": "repeat-quiet_again-2",
   "moment": "quiet_again",
   "old": null,
   "conds": "again",
   "text": "WAS IT LEFT LAST TIME? OR RIGHT?",
   "note": "rooms all alike"
  },
  {
   "id": "repeat-quiet_again-3",
   "moment": "quiet_again",
   "old": null,
   "conds": "again",
   "text": "I KNOW THAT STAIN. I THINK.",
   "note": "false recognition"
  },
  {
   "id": "repeat-quiet_again-4",
   "moment": "quiet_again",
   "old": null,
   "conds": "often",
   "text": "I TALK TO MYSELF NOW. WE GET ON.",
   "note": "dark humour"
  },
  {
   "id": "repeat-quiet_again-5",
   "moment": "quiet_again",
   "old": null,
   "conds": "often",
   "text": "WHAT DID MY VOICE SOUND LIKE?",
   "note": "said aloud, eerie"
  },
  {
   "id": "repeat-quiet_again-6",
   "moment": "quiet_again",
   "old": null,
   "conds": "sociable often",
   "text": "I'M FORGETTING HOW FACES GO.",
   "note": "loneliness eroding memory"
  },
  {
   "id": "repeat-quiet_again-7",
