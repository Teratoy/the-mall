   "id": "repeat-low_again-5",
   "moment": "low_again",
   "old": null,
   "conds": "often",
   "text": "I USED TO BE SOMEONE WHO WOULDN'T.",
   "note": "lost self"
  },
  {
   "id": "repeat-low_again-6",
   "moment": "low_again",
   "old": null,
   "conds": "often",
   "text": "IT'S ALMOST GOOD. THAT'S THE WORST PART.",
   "note": "horror at own adaptation"
  },
  {
   "id": "repeat-low_again-7",
   "moment": "low_again",
   "old": null,
   "conds": "guilty",
   "text": "I DESERVE THIS. I DESERVE WORSE.",
   "note": "guilt as punishment"
  },
  {
   "id": "repeat-low_again-8",
   "moment": "low_again",
   "old": null,
   "conds": "craving",
   "text": "MORE. THERE'S ALWAYS MORE.",
   "note": "craving, unhinged"
  },
  {
   "id": "repeat-low_again-9",
   "moment": "low_again",
   "old": null,
   "conds": "brave",
   "text": "A STOMACH IS A STOMACH.",
   "note": "brave, hard"
  },
  {
